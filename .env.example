# Copy to .env.local and fill in. .env.local is gitignored — never commit it.

# --- Shopify Storefront API ---------------------------------------------
# Shopify admin > Sales channels > Headless > Storefront API.
# This is the PUBLIC token: read-only and safe to expose in a browser.
# NEVER put an Admin API token (shpat_...) in this application.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
SHOPIFY_API_VERSION=2026-07

# Signing secret shown by Shopify when you create a webhook under
# Settings → Notifications → Webhooks. Required by POST /api/revalidate,
# which re-renders the site the moment the catalogue changes. Without it that
# endpoint refuses every request and the site falls back to revalidating on a
# five-minute timer.
SHOPIFY_WEBHOOK_SECRET=

# Judge.me reviews. From the Judge.me admin: Settings → Integrations →
# View API tokens. Use the PRIVATE token — the read endpoints authenticate
# with it and it must never reach the browser. Leave blank and the reviews
# section is simply not rendered; nothing else on the site changes.
JUDGEME_PRIVATE_TOKEN=
# Defaults to SHOPIFY_STORE_DOMAIN. Only set this if Judge.me knows the shop
# under a different domain.
JUDGEME_SHOP_DOMAIN=
# shopify | woocommerce | bigcommerce — required by the review create endpoint.
JUDGEME_PLATFORM=shopify

# --- Site ----------------------------------------------------------------
# Canonical origin used for metadata, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://pro1st.in

# --- Optional ------------------------------------------------------------
# Stock-alert signup endpoint. Unset = the form says so instead of faking it.
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=
